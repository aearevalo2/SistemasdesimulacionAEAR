<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SistemasdesimulacionAEAR.MainPage"
             Title="Calificaciones"
             BackgroundColor="#F5F7F2">
    <ContentPage.Resources>
        <Color x:Key="Ink">#16343B</Color>
        <Color x:Key="Muted">#71858A</Color>
        <Color x:Key="Teal">#0F766E</Color>
        <Color x:Key="Coral">#F07861</Color>
        <Color x:Key="Line">#E2EAE6</Color>
        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="#F5F8F6" />
            <Setter Property="TextColor" Value="#16343B" />
            <Setter Property="PlaceholderColor" Value="#91A2A3" />
            <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="#16343B" />
            <Setter Property="TitleColor" Value="#91A2A3" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="18,18,18,30" Spacing="16">
            <!-- Encabezado de identidad -->
            <Border Padding="20,19" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#125B61" Offset="0.0" />
                        <GradientStop Color="#123D49" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Border BackgroundColor="#FFFFFF22" Padding="7,3" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Label Text="✦" FontSize="13" TextColor="#F8C982" VerticalOptions="Center" />
                        </Border>
                        <Label Text="INSTITUTO SUDAMERICANO" FontSize="11" FontAttributes="Bold" TextColor="#B9E1D7" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border Grid.Column="1" BackgroundColor="#FFFFFF20" Padding="10,6" StrokeThickness="0" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Label Text="PERÍODO 1" FontSize="9" FontAttributes="Bold" TextColor="White" />
                    </Border>
                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="Sistema de&#10;calificaciones" FontSize="30" LineHeight="0.95" FontAttributes="Bold" TextColor="White" Margin="0,15,0,2" />
                    <Label Grid.Row="2" Grid.ColumnSpan="2" Text="Tus notas, claras y al día." FontSize="13" TextColor="#C9E2DC" />
                </Grid>
            </Border>
            <!-- Selección de estudiante -->
            <Border BackgroundColor="White" Stroke="#E2EAE6" StrokeThickness="1" Padding="16,15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="7">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                        <Border BackgroundColor="#E2F3ED" Padding="7,5" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="9" />
                            </Border.StrokeShape>
                            <Label Text="01" FontSize="10" FontAttributes="Bold" TextColor="#0F766E" />
                        </Border>
                        <Label Grid.Column="1" Text="ESTUDIANTE" FontSize="11" CharacterSpacing="1.1" FontAttributes="Bold" TextColor="#71858A" VerticalOptions="Center" />
                    </Grid>
                    <Picker x:Name="StudentPicker" Title="Selecciona un estudiante" />
                    <Label Text="Elige uno de los 5 estudiantes" FontSize="11" TextColor="#91A2A3" />
                </VerticalStackLayout>
            </Border>
            <!-- Parcial 1 -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" Margin="2,2,0,-8">
                <Border BackgroundColor="#0F766E" WidthRequest="27" HeightRequest="27" Padding="0" StrokeThickness="0" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="9" />
                    </Border.StrokeShape>
                    <Label Text="1" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <Label Grid.Column="1" Text="PRIMER PARCIAL" FontSize="12" CharacterSpacing="1.3" FontAttributes="Bold" TextColor="#0F766E" VerticalOptions="Center" />
            </Grid>
            <Border BackgroundColor="White" Stroke="#E2EAE6" StrokeThickness="1" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <Label Text="Seguimiento 1" FontSize="14" FontAttributes="Bold" TextColor="#16343B" VerticalOptions="Center" />
                        <Border Grid.Column="1" BackgroundColor="#E2F3ED" Padding="9,4" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Label Text="30%" FontSize="10" FontAttributes="Bold" TextColor="#0F766E" />
                        </Border>
                        <Entry x:Name="Follow1Entry" Grid.Row="1" Grid.ColumnSpan="2" Placeholder="Nota de 0 a 10" Keyboard="Numeric" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#EDF1EE" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <Label Text="Examen 1" FontSize="14" FontAttributes="Bold" TextColor="#16343B" VerticalOptions="Center" />
                        <Border Grid.Column="1" BackgroundColor="#FFF0E8" Padding="9,4" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Label Text="20%" FontSize="10" FontAttributes="Bold" TextColor="#C45D49" />
                        </Border>
                        <Entry x:Name="Exam1Entry" Grid.Row="1" Grid.ColumnSpan="2" Placeholder="Nota de 0 a 10" Keyboard="Numeric" />
                    </Grid>
                    <Grid BackgroundColor="#EAF5F0" Padding="12,10" ColumnDefinitions="*,Auto">
                        <Label Text="Subtotal del parcial" FontSize="12" FontAttributes="Bold" TextColor="#31645A" VerticalOptions="Center" />
                        <Label x:Name="Partial1Label" Grid.Column="1" Text="— / 5,0" FontSize="14" FontAttributes="Bold" TextColor="#0F766E" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <!-- Parcial 2 -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" Margin="2,2,0,-8">
                <Border BackgroundColor="#EAA45B" WidthRequest="27" HeightRequest="27" Padding="0" StrokeThickness="0" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="9" />
                    </Border.StrokeShape>
                    <Label Text="2" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <Label Grid.Column="1" Text="SEGUNDO PARCIAL" FontSize="12" CharacterSpacing="1.3" FontAttributes="Bold" TextColor="#B77938" VerticalOptions="Center" />
            </Grid>
            <Border BackgroundColor="White" Stroke="#E2EAE6" StrokeThickness="1" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <Label Text="Seguimiento 2" FontSize="14" FontAttributes="Bold" TextColor="#16343B" VerticalOptions="Center" />
                        <Border Grid.Column="1" BackgroundColor="#E2F3ED" Padding="9,4" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Label Text="30%" FontSize="10" FontAttributes="Bold" TextColor="#0F766E" />
                        </Border>
                        <Entry x:Name="Follow2Entry" Grid.Row="1" Grid.ColumnSpan="2" Placeholder="Nota de 0 a 10" Keyboard="Numeric" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#EDF1EE" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <Label Text="Examen 2" FontSize="14" FontAttributes="Bold" TextColor="#16343B" VerticalOptions="Center" />
                        <Border Grid.Column="1" BackgroundColor="#FFF0E8" Padding="9,4" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Label Text="20%" FontSize="10" FontAttributes="Bold" TextColor="#C45D49" />
                        </Border>
                        <Entry x:Name="Exam2Entry" Grid.Row="1" Grid.ColumnSpan="2" Placeholder="Nota de 0 a 10" Keyboard="Numeric" />
                    </Grid>
                    <Grid BackgroundColor="#FFF4E7" Padding="12,10" ColumnDefinitions="*,Auto">
                        <Label Text="Subtotal del parcial" FontSize="12" FontAttributes="Bold" TextColor="#8A6336" VerticalOptions="Center" />
                        <Label x:Name="Partial2Label" Grid.Column="1" Text="— / 5,0" FontSize="14" FontAttributes="Bold" TextColor="#B77938" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <!-- Fecha -->
            <Border BackgroundColor="White" Stroke="#E2EAE6" StrokeThickness="1" Padding="16,14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border BackgroundColor="#EEF2F7" WidthRequest="40" HeightRequest="40" Padding="0" StrokeThickness="0" VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="13" />
                        </Border.StrokeShape>
                        <Label Text="◷" FontSize="21" TextColor="#557084" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="FECHA DE EVALUACIÓN" FontSize="10" CharacterSpacing="1" FontAttributes="Bold" TextColor="#71858A" />
                        <DatePicker x:Name="EvaluationDatePicker" Format="dd/MM/yyyy" TextColor="#16343B" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
            <!-- Nota final -->
            <Border Padding="18,17" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#173F4A" Offset="0.0" />
                        <GradientStop Color="#162D3B" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <Label Text="RESULTADO DEL CURSO" FontSize="10" CharacterSpacing="1.2" FontAttributes="Bold" TextColor="#A8D8C9" />
                    <Label Grid.Row="1" Text="Suma de los dos parciales" FontSize="12" TextColor="#C4D8D8" />
                    <Label x:Name="FinalLabel" Grid.Column="1" Grid.RowSpan="2" Text="— / 10" FontSize="27" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                </Grid>
            </Border>
            <Button Text="Calcular calificación" Clicked="OnCalculateClicked" BackgroundColor="#F07861" TextColor="White" FontSize="15" FontAttributes="Bold" CornerRadius="16" HeightRequest="55" />
            <!-- Escala de aprobación -->
            <Border BackgroundColor="White" Stroke="#E2EAE6" StrokeThickness="1" Padding="16,14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="ESCALA DE RESULTADOS" FontSize="10" CharacterSpacing="1.1" FontAttributes="Bold" TextColor="#71858A" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <Border BackgroundColor="#E7F4EC" Padding="9,7" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label Text="●  Aprobado ≥ 7" FontSize="11" FontAttributes="Bold" TextColor="#28734B" />
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="#FFF3DF" Padding="9,7" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label Text="●  Complementario 5–6,9" FontSize="10" FontAttributes="Bold" TextColor="#9A6926" />
                        </Border>
                        <Border Grid.Row="1" BackgroundColor="#FCEBE8" Padding="9,7" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Label Text="●  Reprobado &lt; 5" FontSize="11" FontAttributes="Bold" TextColor="#A84F48" />
                        </Border>
                        <Label Grid.Row="1" Grid.Column="1" Text="Cada nota se ingresa sobre 10" FontSize="10" TextColor="#71858A" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Label Text="Hecho para acompañar tu progreso ✦" FontSize="11" TextColor="#829293" HorizontalTextAlignment="Center" Margin="0,2,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
